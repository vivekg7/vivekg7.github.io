---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { collections } from "../../data/collections";
import {
  STORY_ACCENT,
  clock,
  formatDate,
  getStories,
  shortUrl,
  spoken,
  watchUrl,
} from "../../lib/stories";

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => ({
    params: { id: story.id },
    // Newest first, so "next" is the one before it, wrapping round to the newest.
    props: { story, next: stories[(i + 1) % stories.length] },
  }));
}

const { story, next } = Astro.props;
const s = story.data;
const collection = collections[s.collection];
---

<Base title={`${s.title} — Kahani ki Potli`} description={s.summary}>
  <article style={`--accent: ${STORY_ACCENT}`}>
    <header class="head wrap">
      <a class="back" href="/stories/">
        ← All stories
      </a>
      <p class="eyebrow">
        <a href={`/stories/?c=${s.collection}`}>{collection.label}</a>
        {" · "}
        <span aria-label={spoken(s.duration)}>{clock(s.duration)}</span>
        {" · "}
        <time datetime={s.published.toISOString().slice(0, 10)}>
          {formatDate(s.published)}
        </time>
      </p>
      <h1>{s.title}</h1>
      <p class="title-hi" lang="hi">
        {s.titleHi}
      </p>
    </header>

    <div class="wrap">
      <!-- A link to YouTube until clicked: the player loads only on demand, and
           the link still works without JavaScript. -->
      <div class="player" data-video={s.youtube}>
        <a class="facade" href={watchUrl(s.youtube)}>
          <Image
            src={s.cover}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 72rem) 67rem, 100vw"
            loading="eager"
          />
          <span class="play" aria-hidden="true"></span>
          <span class="visually-hidden">Play the film: {s.title}</span>
        </a>
      </div>

      <div class="actions">
        <a class="button" href={watchUrl(s.youtube)}>
          Watch on YouTube ↗
        </a>
        {s.short && (
          <a class="button" href={shortUrl(s.short)}>
            The reel, as a Short ↗
          </a>
        )}
      </div>
    </div>

    <div class="body wrap">
      <div class="text">
        <section lang="en">
          <h2>The story</h2>
          <p>{s.summary}</p>
          {s.moral && (
            <p class="moral">
              <span>Moral</span>
              {s.moral}
            </p>
          )}
        </section>

        <section lang="hi">
          <h2>कहानी</h2>
          <p>{s.summaryHi}</p>
          {s.moralHi && (
            <p class="moral">
              <span>सीख</span>
              {s.moralHi}
            </p>
          )}
        </section>

        <p class="credit">
          Made by an AI agent with <a href="/projects/talekit/">talekit</a>, for
          the <a href="/stories/">Kahani ki Potli</a> channel.
        </p>
      </div>

      {s.chapters.length > 0 && (
        <aside aria-labelledby="chapters">
          <h2 id="chapters">Chapters</h2>
          <ol class="chapters">
            {s.chapters.map((c) => (
              <li>
                <a href={watchUrl(s.youtube, c.start)} data-start={c.start}>
                  <span class="ts">{clock(c.start)}</span>
                  <span class="ch">
                    {c.title}
                    {c.titleHi && <span lang="hi">{c.titleHi}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    {next.id !== story.id && (
      <nav class="next wrap" aria-label="Next story">
        <a href={`/stories/${next.id}/`}>
          <span class="eyebrow">Next story</span>
          <span class="next-title">{next.data.title} →</span>
          <span class="next-hi" lang="hi">
            {next.data.titleHi}
          </span>
        </a>
      </nav>
    )}
  </article>
</Base>

<script>
  // Swaps the cover for YouTube's player, and makes the chapter links seek in
  // it rather than leave the page. youtube-nocookie.com sets no cookies until
  // the film is played.
  const player = document.querySelector<HTMLDivElement>(".player")!;
  const video = player.dataset.video!;
  let frame: HTMLIFrameElement | undefined;

  function play(start = 0) {
    if (frame) {
      // The embed takes commands by postMessage once enablejsapi=1 is set.
      const send = (func: string, args: unknown[] = []) =>
        frame!.contentWindow?.postMessage(
          JSON.stringify({ event: "command", func, args }),
          "https://www.youtube-nocookie.com",
        );
      send("seekTo", [start, true]);
      send("playVideo");
      return;
    }
    const params = new URLSearchParams({
      autoplay: "1",
      rel: "0",
      enablejsapi: "1",
      origin: location.origin,
      start: String(start),
    });
    frame = document.createElement("iframe");
    frame.src = `https://www.youtube-nocookie.com/embed/${video}?${params}`;
    frame.title = document.querySelector("h1")!.textContent ?? "Film";
    frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    frame.allowFullscreen = true;
    player.replaceChildren(frame);
  }

  player.querySelector("a")!.addEventListener("click", (e) => {
    e.preventDefault();
    play();
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-start]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      play(Number(a.dataset.start));
      player.scrollIntoView({ behavior: "smooth", block: "center" });
    }),
  );
</script>

<style>
  .head {
    padding-top: clamp(1.5rem, 5vw, 3.5rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .eyebrow a {
    color: var(--accent);
    text-decoration: none;
  }

  .eyebrow a:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.25rem);
    margin-top: 0.75rem;
    color: var(--accent);
  }

  .title-hi {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    color: var(--muted);
  }

  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-top: 2.25rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }

  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .facade {
    display: block;
    height: 100%;
  }

  .facade :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: clamp(4rem, 10vw, 5.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 88%, transparent);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
    transition: transform 0.2s ease;
  }

  .play::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    translate: 8% 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.8em 0 0.8em 1.35em;
    border-color: transparent transparent transparent #fff;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
  }

  .facade:hover .play,
  .facade:focus-visible .play {
    transform: scale(1.08);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 0.92rem;
    font-weight: 550;
    text-decoration: none;
    background: var(--surface);
  }

  .button:hover {
    border-color: var(--accent);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-top: 3.5rem;
  }

  .text {
    max-width: var(--prose);
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.8rem;
  }

  section + section {
    margin-top: 2.75rem;
  }

  .text p {
    margin: 0 0 1.1rem;
  }

  .moral {
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    font-family: var(--font-display);
    font-size: 1.12rem;
  }

  .moral span {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .moral span:lang(hi) {
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0;
  }

  .credit {
    margin-top: 2.5rem !important;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--muted);
  }

  aside {
    position: sticky;
    top: 1.5rem;
  }

  .chapters {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .chapters a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.5rem;
    padding: 0.6rem 0.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .chapters a:hover {
    color: var(--accent);
  }

  .ts {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    padding-top: 0.1rem;
  }

  .ch span {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .next {
    margin-top: 5rem;
  }

  .next a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .next-title {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
  }

  .next a:hover .next-title {
    color: var(--accent);
  }

  .next-hi {
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .body {
      grid-template-columns: 1fr;
    }

    aside {
      position: static;
    }
  }
</style>
