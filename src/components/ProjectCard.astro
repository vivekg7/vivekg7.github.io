---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const p = project.data;
const href = p.page ? `/projects/${project.id}/` : p.repo;
const lead = p.facts[0];
---

<a class="card" href={href} style={`--accent: ${p.accent}`}>
  <div class="visual">
    {p.cover ? (
      <Image
        src={p.cover.src}
        alt={p.cover.alt}
        widths={[480, 800, 1100]}
        sizes="(min-width: 60rem) 34rem, 100vw"
      />
    ) : (
      <div class="typographic" aria-hidden="true">
        {lead ? (
          <>
            <span class="big">{lead.value}</span>
            <span class="small">{lead.label}</span>
          </>
        ) : (
          <span class="big">{p.title}</span>
        )}
      </div>
    )}
  </div>
  <div class="body">
    <p class="eyebrow">{p.platforms.join(" · ")}</p>
    <h3>{p.title}</h3>
    <p class="tagline">{p.tagline}</p>
    <ul class="tags">
      {p.stack.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
    <span class="more">{p.page ? "Read more →" : "On GitHub ↗"}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .visual {
    aspect-ratio: 1024 / 500;
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
    overflow: hidden;
  }

  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .typographic {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    color: var(--accent);
  }

  .big {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
  }

  .small {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.4rem 1.4rem;
    flex: 1;
  }

  .body .eyebrow {
    margin: 0;
  }

  h3 {
    font-size: 1.6rem;
  }

  .tagline {
    margin: 0;
    color: var(--muted);
  }

  .tags {
    margin-top: 0.25rem;
  }

  .more {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 550;
    color: var(--accent);
  }
</style>
